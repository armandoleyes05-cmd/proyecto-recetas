-def _unir(nombres: list[str]) -> str:
-    if not nombres:
-        return "sal y pimienta"
-    if len(nombres) == 1:
-        return nombres[0]
-    return ", ".join(nombres[:-1]) + " y " + nombres[-1]
-
-
-def _campos(principal: str, otros: list[str]) -> dict[str, str]:
-    return {
-        "p": principal,
-        "o": _unir(otros),
-        "o2": _unir(otros[:2]),
-        "t": _unir([principal, *otros]),
-    }
