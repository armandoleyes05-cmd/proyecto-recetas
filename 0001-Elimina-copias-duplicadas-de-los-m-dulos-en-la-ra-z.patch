-    if excluir_id is not None:
-        q = q.where(Ingredient.id != excluir_id)
-    return db.scalar(q) is not None
-
-
-def _guardar(db: Session, ing: Ingredient) -> Ingredient:
-    try:
-        db.commit()
-    except IntegrityError:
