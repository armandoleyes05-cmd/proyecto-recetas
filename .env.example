# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env al repositorio.

# --- Dominio y HTTPS (Caddy) ---
DOMAIN=recetas.tudominio.com
ACME_EMAIL=tu-correo@ejemplo.com
APP_URL=https://recetas.tudominio.com

# --- Base de datos MySQL ---
MYSQL_DATABASE=recetas
MYSQL_USER=recetas
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-de-root
MYSQL_HOST=db
MYSQL_PORT=3306
# Alternativa: definir la URL completa (tiene prioridad sobre MYSQL_*)
# DATABASE_URL=mysql+pymysql://usuario:clave@db:3306/recetas?charset=utf8mb4

# --- JWT ---
# Genera uno con: openssl rand -hex 32   (mínimo 32 caracteres)
JWT_SECRET=reemplazar-por-una-cadena-aleatoria-de-64-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM (OpenRouter) ---
# Crea tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-reemplazar
# Revisa los modelos disponibles en https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=60
# Pide al modelo respuesta en modo JSON. Pon false si tu modelo no lo soporta.
LLM_JSON_MODE=true
# true = recetas simuladas sin llamar al LLM (solo para desarrollo)
LLM_MOCK=false
