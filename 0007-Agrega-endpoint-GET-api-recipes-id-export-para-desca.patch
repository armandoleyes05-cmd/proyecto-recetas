--- /dev/null
+++ b/app/routers/export.py
@@ -0,0 +1,37 @@
+"""Descarga de una receta como archivo de texto o Markdown.
+
+`GET /api/recipes/{id}/export?formato=texto|markdown` devuelve el archivo con
+`Content-Disposition: attachment`. Reutiliza la verificación de propiedad del
+router de recetas: una receta ajena responde 404, igual que si no existiera.
+"""
+
+from fastapi import APIRouter, Depends, Query
+from fastapi.responses import Response
+from sqlalchemy.orm import Session
+
+from app.database import get_db
+from app.models import User
+from app.routers.recipes import _a_salida, _obtener
+from app.schemas.exportacion import FormatoExportacion
+from app.security import get_current_user
+from app.services import exportar
+
+router = APIRouter(prefix="/api/recipes", tags=["Recetas"])
+
+
+@router.get("/{receta_id}/export")
+def exportar_receta(
+    receta_id: int,
+    formato: FormatoExportacion = Query(FormatoExportacion.TEXTO),
+    user: User = Depends(get_current_user),
+    db: Session = Depends(get_db),
+):
+    """Descarga la receta como `.txt` o `.md`."""
+    receta = _a_salida(_obtener(db, receta_id, user))
+    return Response(
+        content=exportar.exportar(receta, formato),
+        media_type=formato.media_type,
+        headers={
+            "Content-Disposition": f'attachment; filename="{exportar.nombre_archivo(receta, formato)}"'
+        },
+    )
