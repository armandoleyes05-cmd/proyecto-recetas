@@ -0,0 +1,29 @@
+"""Endpoint de estadísticas del usuario autenticado.
+
+`GET /api/estadisticas` carga las recetas del usuario (con su calificación) y
+delega el cálculo en `services.estadisticas`. Solo ve sus propios datos: el filtro
+por `usuario_id` sale del JWT, nunca de un parámetro de la petición.
+"""
+
+from fastapi import APIRouter, Depends
+from sqlalchemy import select
+from sqlalchemy.orm import Session, selectinload
+
+from app.database import get_db
+from app.models import Recipe, User
+from app.schemas.estadisticas import EstadisticasOut
+from app.security import get_current_user
+from app.services import estadisticas
+
+router = APIRouter(prefix="/api/estadisticas", tags=["Estadísticas"])
+
+
+@router.get("", response_model=EstadisticasOut)
+def resumen(user: User = Depends(get_current_user), db: Session = Depends(get_db)):
+    """Resumen de recetas: totales, promedio de estrellas, dificultad e ingrediente favorito."""
+    recetas = db.scalars(
+        select(Recipe)
+        .where(Recipe.usuario_id == user.id)
+        .options(selectinload(Recipe.calificacion))
+    ).all()
+    return estadisticas.calcular(recetas)
